  "maintenance":{"title":"After Week 12","guidance":"Increase weekly volume gradually rather than increasing both distance and intensity simultaneously.","days":["Day 1: Easy Run (30–40 min)","Day 2: Recovery or Rest","Day 3: Quality Run (Intervals, Tempo, or Hills)","Day 4: Rest","Day 5: Easy Run (30–40 min)","Day 6: Long Run (40–60 min)","Day 7: Rest or Walking"]},
  "rules":[
    {"title":"Run Easy","description":"Most beginner runs should feel comfortable."},
    {"title":"Rest Between Runs","description":"Avoid running all sessions on consecutive days, for example use Mon/Wed/Sat."},
    {"title":"Pain Rule","description":"Stop exercising for sharp or worsening pain, chest pain, or severe dizziness."},
    {"title":"Repeat Week","description":"If a week feels too difficult, repeat it without deleting previous GPS history."}
