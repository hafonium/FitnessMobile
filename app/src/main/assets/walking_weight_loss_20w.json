  "rules":[
    {"title":"Build Gradually","description":"Increase duration or intensity progressively, not both at once."},
    {"title":"Keep Easy Days Easy","description":"Easy and recovery walks should remain conversational."},
    {"title":"Rest When Needed","description":"Use a rest day when fatigue or soreness changes your walking form."},
    {"title":"Pain Rule","description":"Stop for sharp or worsening pain, chest pain, or severe dizziness."}
